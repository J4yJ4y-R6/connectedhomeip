#
#    Description:
#      Some useful defaults for the demo app configuration.
#

#enable BT
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

#disable BT connection reattempt
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n

#enable lwip ipv6 autoconfig
CONFIG_LWIP_IPV6_AUTOCONFIG=y

#enable debug shell
CONFIG_ENABLE_CHIP_SHELL=y

# Use a custom partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

#enable lwIP route hooks
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y

# Serial Flasher config
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Disable softap support by default
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
# This example uses the older version of RMT driver to work with both
# idf-v4.4.3 and idf-v5.0, so suppressing the warnings by setting below option
CONFIG_RMT_SUPPRESS_DEPRECATE_WARN=y

# Enable HKDF in mbedtls
CONFIG_MBEDTLS_HKDF_C=y

# Disable Read Client
CONFIG_DISABLE_READ_CLIENT=y

# Increase LwIP IPv6 address number
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6

# Enable OTA Requestor
CONFIG_ENABLE_OTA_REQUESTOR=y

# PQC: CASE messages grow to ~1.4KB (Sigma1), ~6KB (Sigma2/3) with Kyber+Dilithium
# Expand mbedTLS TLS record buffers to match the 16KB PacketBuffer cap
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=16384

# Kyber-768 indcpa needs ~12.4KB of stack and runs on the CHIP task; Dilithium-3
# (~78KB) is offloaded to its own deep-stack task in CHIPCryptoPALPQC.cpp.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_CHIP_TASK_STACK_SIZE=24576

# PQC: a hybrid CASE Sigma2 is ~7.7KB, far beyond the ~1.5KB lwIP pbuf pool buffer.
# Switch CHIP PacketBuffers to heap-backed PBUF_RAM (maps to
# CHIP_SYSTEM_CONFIG_PACKETBUFFER_LWIP_PBUF_RAM via src/platform/ESP32/SystemPlatformConfig.h)
# so CHIP_SYSTEM_CONFIG_PQC_PACKETBUFFER_CAPACITY_MAX applies.
CONFIG_USE_LWIP_PBUF_RAM_PACKETBUFFER=y

# PQC: those CASE datagrams exceed the link MTU and arrive fragmented; lwIP drops
# fragments unless reassembly is compiled in (both default to n).
CONFIG_LWIP_IP6_REASSEMBLY=y
CONFIG_LWIP_IP4_REASSEMBLY=y
CONFIG_LWIP_IP_REASS_MAX_PBUFS=40
